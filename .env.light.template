# ==============================================================================
# Docker Compose Environment Variables (Standalone Mode)
# Этот файл используется ТОЛЬКО для конфигурации Docker-контейнеров.
# Не путать с .env файлом самого Laravel приложения!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# Эти переменные используются сервисом 'postgres' для инициализации БД,
# а также передаются в сервис 'app' для подключения к этой БД.
# ------------------------------------------------------------------------------
DB_USER=sentiment_user
DB_PASSWORD=super_secret_password_123
DB_NAME=sentiment_db

# Внешний порт для подключения к БД с хост-машины (например, через DBeaver).
# Изменен на 54320, чтобы не конфликтовать с локальным PostgreSQL, если он есть.
# Если доступ снаружи не нужен, можно оставить пустым или закомментировать строку ports в compose.yml
DB_PORT_EXTERNAL=54320

# ------------------------------------------------------------------------------
# LLM Configuration (Passed to Laravel App Container)
# Настройки для подключения Laravel-приложения к локальному Ollama внутри Docker-сети.
# ------------------------------------------------------------------------------
# ВАЖНО: Внутри Docker-сети обращение идет по имени сервиса ('ollama'), а не localhost!
LLM_BASE_URL=http://ollama:11434/v1

# Ollama не требует реального ключа, но пакет openai-php/client ожидает строку.
LLM_API_KEY=ollama_dummy_key

# Модель, которую скрипт entrypoint скачает при первом запуске контейнера ollama
LLM_MODEL=qwen2.5:3b