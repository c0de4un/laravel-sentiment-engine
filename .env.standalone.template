# ==============================================================================
# Docker Compose Environment Variables (Standalone Mode)
# Этот файл используется ТОЛЬКО для конфигурации Docker-контейнеров.
# Не путать с основным .env файлом самого Laravel-приложения!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# Эти переменные инициализируют БД и передаются в API-контейнер для подключения.
# ------------------------------------------------------------------------------
DB_USER=sentiment_user
# Используйте сложный пароль даже в локальной среде (best practice)
DB_PASSWORD=SuperSecretPassword123!
DB_NAME=sentiment_db

# Внешний порт для подключения к БД с хост-машины (например, через DataGrip/DBeaver).
# 54320 выбран, чтобы избежать конфликтов с локальным PostgreSQL на порту 5432.
DB_PORT_EXTERNAL=54320

# ------------------------------------------------------------------------------
# 2. Redis Configuration (Cache & Queues)
# Настройки для подключения Laravel-приложения к Redis внутри Docker-сети.
# ------------------------------------------------------------------------------
# Имя сервиса в docker-compose.yml
REDIS_HOST=redis
# Внутренний порт Redis (всегда 6379 внутри сети)
REDIS_PORT=6379
# Внешний порт для отладки через Another Redis Desktop Manager (опционально)
REDIS_PORT_EXTERNAL=6380
# Пароль Redis (оставьте пустым для локальной разработки, в проде обязателен)
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. LLM / AI Configuration (Ollama)
# Настройки для подключения к локальному LLM-провайдеру.
# ------------------------------------------------------------------------------
# ВАЖНО: Внутри Docker-сети обращение идет по имени сервиса ('ollama'), а не localhost!
LLM_BASE_URL=http://ollama:11434/v1

# Ollama не требует реального ключа, но пакет openai-php/client ожидает строку.
LLM_API_KEY=ollama_dummy_key

# Модель для анализа тональности.
# qwen2.5:1.5b - идеальный баланс: весит ~1 ГБ, быстро грузится, отлично держит JSON-схемы.
# При желании можно сменить на qwen2.5:3b или qwen2.5:7b (потребуется больше RAM).
LLM_MODEL=qwen2.5:1.5b

# ------------------------------------------------------------------------------
# 4. Laravel API Container Overrides (Optional)
# Переопределение базовых настроек Laravel непосредственно для Docker-контейнера.
# ------------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
# Секретный ключ будет сгенерирован при первом запуске, если его нет в основном .env
# APP_KEY=base64:...