{
    "openapi": "3.0.0",
    "info": {
        "title": "Sentiment Analyzer API",
        "description": "API documentation for Sentiment Analyzer",
        "contact": {
            "name": "Денис Зямаев",
            "email": "code4un@yandex.ru"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Localhost"
        }
    ],
    "paths": {
        "/api/auth/signin": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Вход в систему (Авторизация)",
                "description": "Аутентифицирует пользователя по email и паролю. При успехе устанавливает HttpOnly сессионную куку (Sanctum SPA mode).",
                "operationId": "e9bcf9f894379a5f17d5bc19f5d4ada2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "description": "Email адрес пользователя",
                                        "type": "string",
                                        "format": "email",
                                        "example": "code4un@yandex.ru"
                                    },
                                    "password": {
                                        "description": "Пароль пользователя",
                                        "type": "string",
                                        "format": "password",
                                        "example": "SuperSecretPassword123!"
                                    },
                                    "remember": {
                                        "description": "Флаг \"Запомнить меня\" для продления жизни сессии",
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешная авторизация. Сессионная кука установлена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Успешный вход в систему."
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Денис Зямаев"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "code4un@yandex.ru"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверный email или пароль",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Неверные учетные данные."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации данных запроса"
                    },
                    "429": {
                        "description": "Превышен лимит попыток входа (Rate Limit)"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Enter your token: Bearer {token} (for mobile clients). For SPA (Nuxt.js) auth is via HttpOnly cookies automatically.",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication routes"
        }
    ]
}